# ---------------------------------------------------------------
# exx.grok settings
# Copy this file to ".env" (same folder) and fill in what you have.
# Anything left blank just turns that feature off; the app still runs.
# Never share your .env file. It holds the keys that can post as you.
# ---------------------------------------------------------------

# Port the app runs on: open http://localhost:5177 in Chrome
PORT=5177

# Bind address. Leave blank to stay on this computer only (127.0.0.1).
# Set to 0.0.0.0 when hosting, or when a platform sets HOST for you.
HOST=

# Shared password for the login page. Required before the app will listen
# on a public address. Leave blank for local-only use (no login screen).
# Anyone with this password can Publish to @EXXAlerts, so pick a strong one
# and only share it with people you trust.
APP_PASSWORD=

# Signs the login cookie. If you leave this blank, a random secret is made
# at each start and everyone is signed out when the app restarts.
# For a hosted link, set a long random string and keep it private.
SESSION_SECRET=

# Your X handle (without @). Used for the Top 5 posts row.
X_USERNAME=EXXAlerts

# Accounts shown in the X feed column (comma separated, no @)
X_FEED_ACCOUNTS=EricLDaugh,LeadingReport,CollinRugg,Breaking911,NickSortor

# ---- X (Twitter) API: from developer.x.com > your app > "Keys and tokens" ----
# Bearer Token: used to read the X feed column.
X_BEARER_TOKEN=
# OAuth 1.0a keys: needed to read your own posts and to PUBLISH + upload media.
# The app must have "Read and write" permission BEFORE you generate the Access Token.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ---- AI writing (xAI Grok by default; any OpenAI-compatible API works) ----
# Get a key at console.x.ai
AI_API_KEY=
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4.3

# ---- Refresh timing (minutes) ----
# News + local stories refresh (free except the AI pick of local stories)
NEWS_REFRESH_MIN=10
# X feed refresh. Each NEW post read costs about $0.005 on X's pay-per-use plan.
X_FEED_REFRESH_MIN=10
# Your Top 5 posts refresh (your own posts are billed at the cheaper "owned read" rate)
TOP_REFRESH_MIN=60
# Trending section (X Trends API + Google Trends). X charges $0.010 per trends call.
# 15 minutes is about $0.96/day if the app runs 24/7, or about $29/month. Raise this to spend less.
TRENDS_REFRESH_MIN=15

# Set to 1 to test the Publish button without actually posting (nothing is sent to X)
DRY_RUN=0

# Set ALLOW_PUBLISH=0 on a shared/hosted copy to turn off posting to X (Publish and media upload return 403).
ALLOW_PUBLISH=1
